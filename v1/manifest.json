{
  "manifest_version": 3,
  "name": "LeetCode Helper Extension",
  "version": "1.0",
  "description": "Capture network and user interaction data on LeetCode and send it to a Python backend.",
  "permissions": [
    "tabs",
    "scripting",
    "storage",
    "contextMenus"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "LeetCode Helper"
  },
  "content_scripts": [
    {
      "matches": ["https://leetcode.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon.ico",
    "48": "icons/icon.ico",
    "128": "icons/icon.ico"
  }
}
